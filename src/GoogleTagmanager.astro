---
// component: src/components/common/GoogleTagmanager.astro
export interface Props {
  id: string;
  domain?: string;
  container?: string;
}

const {
  id = "GTM_MEASUREMENT_ID",
  domain = "https://www.googletagmanager.com",
  container = "gtm.js",
} = Astro.props;

const gtmScript = `<script>
    // Clean up existing GTM instance and dataLayer
    window.dataLayer = window.dataLayer || [];

    // Initialize GTM
    function initGTM() {
      window.dataLayer.push({
        'gtm.start': new Date().getTime(),
        'event': '${container}'
      });

      const existingScript = document.querySelector('script[src*="googletagmanager.com"]');
      if (existingScript) {
        existingScript.remove();
      }

      const script = document.createElement('script');
      script.async = true;
      script.src = '${domain}/${container}?id=${id}';
      document.head.appendChild(script);
    }

    // Initialize on first load
    initGTM();

    // Re-initialize on View Transitions
    document.addEventListener('astro:after-swap', function() {
      // Clean up old dataLayer
      window.dataLayer = [];
      // Re-initialize GTM
      initGTM();
    });
</script>`;
---

<!-- Global site tag - Google Tagmanager -->
<Fragment set:html={`${gtmScript}`} />
<!-- Einde Global site tag - Google Tagmanager -->
