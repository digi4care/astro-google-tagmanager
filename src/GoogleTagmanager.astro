---
// component: src/components/common/GoogleTagmanager.astro
export interface Props {
  id: string;
  domain?: string;
  container?: string;
}

const {
  id = "GTM_MEASUREMENT_ID",
  domain = "https://www.googletagmanager.com",
  container = "gtm.js",
} = Astro.props;

const gtmScript = `<script>
    // Initialize dataLayer if not exists
    window.dataLayer = window.dataLayer || [];

    // Initialize GTM
    function initGTM() {
      try {
        // Push page transition event
        window.dataLayer.push({
          'gtm.start': new Date().getTime(),
          'event': '${container}',
          'newPage': true
        });

        // Remove existing GTM script if present
        const existingScript = document.querySelector('script[src*="googletagmanager.com"]');
        if (existingScript) {
          existingScript.remove();
        }

        // Create and inject new GTM script
        const script = document.createElement('script');
        script.async = true;
        script.src = '${domain}/${container}?id=${id}';
        document.head.appendChild(script);
      } catch (error) {
        console.error('Error initializing GTM:', error);
      }
    }

    // Initialize on first load
    initGTM();

    // Handle View Transitions
    document.addEventListener('astro:after-swap', function() {
      // Preserve existing dataLayer data but mark new page load
      initGTM();
    });
</script>`;
---

<!-- Global site tag - Google Tagmanager -->
<Fragment set:html={`${gtmScript}`} />
<!-- Einde Global site tag - Google Tagmanager -->
