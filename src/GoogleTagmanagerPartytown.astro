---
// component: src/components/common/GoogleTagmanagerPartytown.astro
export interface Props {
	id: string;
}

const { id } = Astro.props;
const safeId = JSON.stringify(id).replace(/</g, "\\u003c");

const gtmScript = `
  <script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}"></script>
  <script type="text/partytown">
    window.dataLayer = window.dataLayer || [];
    window.gtag = function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', ${safeId});
  </script>
`;
---

<!-- Global site tag - Google Tagmanager -->
<Fragment set:html={`${gtmScript}`} />
<!-- Einde Global site tag - Google Tagmanager -->
